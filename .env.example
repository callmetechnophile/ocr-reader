# Textbook OCR Microservice Configuration
OCR_APP_NAME="Textbook OCR Microservice"
OCR_APP_ENV="development"
OCR_DEBUG=false
OCR_HOST="0.0.0.0"
OCR_PORT=8000
OCR_MAX_FILE_SIZE_MB=250
OCR_RENDER_DPI=150
OCR_TEXT_QUALITY_THRESHOLD=0.70
OCR_STORAGE_PATH="./data"
OCR_WORKER_COUNT=4
OCR_LOG_LEVEL="INFO"
OCR_BASELINE_BACKEND="baseline"
